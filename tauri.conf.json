{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gachaos",
  "version": "0.3.0",
  "identifier": "com.vectorsophie.gachaos",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "gachaos.exe",
        "width": 400,
        "height": 470,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "targets": [
      "deb",
      "appimage",
      "app",
      "dmg"
    ],
    "category": "Game",
    "shortDescription": "A boredom gacha that curses your desktop",
    "publisher": "VectorSophie"
  }
}
